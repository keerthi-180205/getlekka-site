# ---------- dependencies ----------
/node_modules
/.pnp
.pnp.js

# ---------- Next.js build output (regenerated by `npm run build`) ----------
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ---------- environment & secrets ----------
# Never commit real keys. Commit only .env.example (placeholders).
.env
.env.*
!.env.example
*.pem

# ---------- tests & reports ----------
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---------- deploy tooling ----------
.vercel
.wrangler/
.dev.vars

# ---------- logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---------- editors & OS ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------- local AI-tool settings (keep launch.json, ignore personal state) ----------
.claude/settings.local.json

# ---------- scratch files ----------
copy-for-review.md
