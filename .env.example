# Copy this file to `.env.local` and fill in real values. `.env.local` is git-ignored.
#
# Form endpoints (https://formspree.io): create one form for each of these,
# then paste ONLY the id (the part after /f/ in the form URL), e.g. "xyzabcde".
#
# These are NEXT_PUBLIC_*, so they are baked into the static site at build time:
# set them in your host's dashboard (Cloudflare Pages / Vercel) BEFORE building.
# If a value is missing, that form shows a "couldn't send" message instead of a fake success.

NEXT_PUBLIC_FORMSPREE_PILOT_ID=
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
